# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
.terraform.lock.hcl.bak
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Bootstrap keeps LOCAL state -- never commit it, it is not encrypted.
bootstrap/terraform.tfstate
bootstrap/terraform.tfstate.backup

# Sensitive: variable files may contain account IDs / ARNs
*.auto.tfvars
secrets.tfvars

# AWS / credentials -- never commit
.aws/
credentials
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Spec + secrets for the web app -- never commit
Election monitor web app prompt.docx
admin user and pwd.txt
~$*.xlsx
~$*.docx
osun-polling-units.xlsx
osun-polling-units.csv
.admin-ssm.json

